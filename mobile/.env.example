# Copy this file to `.env` (gitignored, never commit real values) and set the
# backend URL your build should talk to. Expo SDK 54 inlines EXPO_PUBLIC_-prefixed
# vars at build time automatically -- no extra config needed.
#
# Local dev (FastAPI running on this machine, phone/simulator on the same network):
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

# If unset, constants/config.ts falls back to a hardcoded dev IP that will go
# stale the moment the network changes -- setting this explicitly is preferred
# over relying on that fallback.

# Sprint 3.6.9 Block 1: which environment this build considers itself.
# "development" (the default when unset, so local `expo start` needs no change)
# permits the LAN fallback above. eas.json's own "preview"/"production" build
# profiles set this to "preview"/"production" automatically -- do not set it
# here, .env is for local dev only, and a release build must get its API base
# URL from eas.json's env block for that profile, never from this file.
EXPO_PUBLIC_APP_ENV=development

# V2.3A -- Identity & Account Foundation. Optional: unset means authentication
# is entirely inert (anonymous-only, no sign-in UI rendered at all). Set to
# your Clerk project's real Publishable key (starts pk_test_/pk_live_, found
# under Clerk dashboard -> API Keys) to enable sign-in locally. This is a
# client-safe value, not a secret -- Clerk's own docs describe it as meant to
# ship in the app bundle.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
